#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        st: space_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
        };
    };
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
          &kp Q  &kp W  &kp E             &kp R               &kp T          &kp Y                   &kp U            &kp I      &kp O    &kp P
          &kp A  &kp S  &kp D             &kp F               &kp G          &kp H                   &kp J            &kp K      &kp L    &kp SEMICOLON
&kp BSLH  &kp Z  &kp X  &kp C             &kp V               &kp B          &kp N                   &kp M            &kp COMMA  &kp DOT  &kp SLASH      &kp APOSTROPHE
                        &mt LCTRL ESCAPE  &mt LEFT_GUI MINUS  &st 1 SPACE    &mt LEFT_ALT BACKSPACE  &mt LSHFT ENTER  &st 4 TAB
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
              &kp TILDE       &trans     &kp UP_ARROW  &trans     &kp LBRC    &kp RBRC  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
              &kp LEFT_SHIFT  &kp LEFT   &kp DOWN      &kp RIGHT  &kp LBKT    &kp RBKT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&kp LEFT_ALT  &kp LEFT_WIN    &kp MINUS  &to 2         &kp PLUS   &kp LPAR    &kp RPAR  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK  &kp PLUS
                                         &trans        &trans     &trans      &trans    &trans        &kp DOT
            >;
        };

        Gaming {
            display-name = "Game";
            bindings = <
            &kp Z           &kp X  &kp C      &kp V         &sl 3        &trans  &trans  &trans  &trans  &trans
            &kp TAB         &kp Q  &kp W      &kp E         &kp R        &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp LEFT_SHIFT  &kp A  &kp S      &kp D         &kp F        &trans  &trans  &trans  &trans  &trans  &to 0
                                   &kp LCTRL  &kp LEFT_ALT  &kp SPACE    &trans  &trans  &trans
            >;
        };

        Gaming+ {
            display-name = "Game+";
            bindings = <
        &kp F10  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp T     &kp RA(RC(Y))  &kp RA(RC(U))  &trans  &trans  &kp LC(RA(DEL))
        &kp L    &kp O         &kp Y         &kp K         &kp G     &kp F5         &kp F7         &trans  &trans  &kp F12
&trans  &to 0    &trans        &trans        &trans        &trans    &trans         &trans         &trans  &trans  &kp F22          &kp LA(F4)
                               &kp J         &kp I         &kp M     &trans         &trans         &trans
            >;
        };

        code {
            bindings = <
            &kp EXCLAMATION  &kp AT_SIGN  &kp HASH          &kp DOLLAR            &kp PERCENT       &kp CARET   &kp AMPERSAND          &kp ASTERISK       &kp C_VOLUME_UP  &kp C_VOLUME_DOWN
            &kp TILDE        &kp GRAVE    &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp C_PREVIOUS    &kp C_NEXT  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp EQUAL        &kp PLUS
&kp DELETE  &trans           &trans       &kp N0            &kp LEFT_BRACE        &trans            &trans      &kp RIGHT_BRACE        &kp C_PLAY_PAUSE   &trans           &trans             &trans
                                          &trans            &kp MINUS             &trans            &trans      &trans                 &trans
            >;
        };
    };
};
